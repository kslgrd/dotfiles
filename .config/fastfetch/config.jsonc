{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": { "top": 1 }
  },
  "modules": [
    { "type": "title", "format": "HomeBot", "keyColor": "red" },
    "break",
    { "type": "os", "key": "OS", "keyColor": "yellow" },
    { "type": "kernel", "key": "Kernel", "keyColor": "green" },
    { "type": "uptime", "key": "Uptime", "keyColor": "cyan" },
    { "type": "shell", "key": "Shell", "keyColor": "blue" },
    { "type": "terminal", "key": "Terminal", "keyColor": "magenta" },
    { "type": "cpu", "key": "CPU", "keyColor": "red" },
    { "type": "memory", "key": "Memory", "keyColor": "yellow" },
    { "type": "disk", "key": "Disk", "folders": "/", "keyColor": "green" },
    { "type": "localip", "key": "IP", "format": "{ipv4} ({ifname})", "keyColor": "cyan" },
    "break",
    { "type": "colors" }
  ]
}
