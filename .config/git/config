[user]
  email = keith@thesilgards.com
  name = Keith Silgard
[core]
  editor = code --wait
[init]
  defaultBranch = main
[color]
  ui = auto
[pull]
  rebase = true
[push]
  autoSetupRemote = true
[fetch]
  prune = true
[rerere]
  enabled = true
[merge]
  conflictStyle = zdiff3
[diff]
  algorithm = histogram
  mnemonicPrefix = true
  tool = vscode
[difftool "vscode"]
  cmd = code --wait --diff $LOCAL $REMOTE
[tag]
  sort = version:refname
[versionsort]
  suffix = -pre
  suffix = .pre
  suffix = -beta
  suffix = .beta
  suffix = -rc
  suffix = .rc
[alias]
  lg = log --graph --date=relative --pretty=tformat:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%an %ad)%Creset'
  oops = commit --amend --no-edit
  reword = commit --amend
  uncommit = reset --soft HEAD~1
